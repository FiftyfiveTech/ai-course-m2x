# Names only — never real values. Real keys live in ~/.config/, outside the repo.
#
# Secrets belong here. Non-secret configuration — which provider serves which model,
# and what each model costs — lives in the tracked config/models.toml, so that a fresh
# clone can reproduce the cost report without access to anyone's keys.

# --- Credentials -------------------------------------------------------------------
HF_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# region host — this project is on US cloud
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Local inference ---------------------------------------------------------------
# Host only, no /v1 suffix. Machine-local, which is why it is an env var and not
# committed config.
OLLAMA_HOST=http://localhost:11434

# --- Adapter behaviour (all optional; defaults shown) -------------------------------
# Force every call onto one provider regardless of each model's default. This is the
# switch the three-provider comparison uses — set it to groq, then nim, then ollama and
# re-run the same command. A model with no route to the named provider errors rather
# than falling back silently, so a failed leg of the comparison cannot pass unnoticed.
M2X_PROVIDER_OVERRIDE=

# Set to false to force real network calls, e.g. when measuring cold latency.
M2X_CACHE_ENABLED=true

# Total tries per call including the first, and the initial backoff in seconds
# (doubles per attempt; a provider's Retry-After header overrides it).
M2X_MAX_ATTEMPTS=3
M2X_RETRY_BASE_DELAY_S=0.5

# Generous by default: local transcription of a long clip is slow.
M2X_REQUEST_TIMEOUT_S=120

# Paths, relative to the repository root.
M2X_MODELS_CONFIG=config/models.toml
M2X_CACHE_DIR=data/cache
M2X_RUNS_LOG=data/runs/runs.jsonl
